# Copy to .env and edit. Do not put secrets in this file.
# Paths are relative to the repository root unless absolute.

BEAI_DATABASE_URL=sqlite:///data/beai.sqlite
BEAI_STORAGE_DIR=data/structures
BEAI_MAX_UPLOAD_BYTES=52428800
BEAI_MAX_ATOM_COUNT=200000
BEAI_CORS_ORIGINS=http://127.0.0.1:8732,http://localhost:8732
BEAI_HOST=127.0.0.1
BEAI_PORT=8731
BEAI_CA_BREAK_THRESHOLD_ANGSTROM=4.5
BEAI_LOG_LEVEL=INFO
